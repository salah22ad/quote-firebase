rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 1. منع أي وصول مباشر من التطبيق لمجموعة المدراء أو مجموعات بث الإشعارات أو السجلات
    // (جميعها تُدار حصرياً عبر Cloud Functions في السيرفر)
    match /admins/{adminId} {
      allow read, write: if false;
    }

    match /global_notifications/{notifId} {
      allow read, write: if false;
    }

    match /global_translate_notifications/{notifId} {
      allow read, write: if false;
    }

    match /admin_notifications/{notifId} {
      allow read, write: if false;
    }

    match /deletionLogs/{logId} {
      allow read, write: if false;
    }

    // 2. مجموعة المستخدمين: كل مستخدم يصل لبياناته فقط مع منع تعديل userType
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'is_premium', 'devices'])
        && (!('userType' in request.resource.data) || request.resource.data.userType == 'user');

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userType']));

      allow delete: if false;
    }

    // 3. مجموعة الضيوف
    match /guests/{guestId} {
      allow read, write, update: if true;
    }

    // 4. البيانات العامة وإعدادات التطبيق (قراءة فقط للتطبيق)
    match /public/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /app_config/{document} {
      allow read: if true;
      allow write: if false;
    }

    // 5. إشعارات الدعوات والمكافآت بين المستخدمين
    match /referral_notifications/{notifId} {
      allow create: if isSignedIn() &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.targetUid is string &&
        request.resource.data.type == 'referral';

      allow read, update, delete: if isSignedIn() && resource.data.targetUid == request.auth.uid;
    }
  }
}
